{
  "name": "nestjs",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "Mozilla Public License 2.0",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "compile": "tsc --noEmit",
    "start": "nest start --watch | pino-pretty -i time,remoteAddress,req,reqId",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/nestjs/src/main.js",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "openapi": "npm run openapi:spec && npm run openapi:sdk && npm run openapi:format",
    "openapi:spec": "ts-node --project tsconfig.json ./src/openapi-spec.ts",
    "openapi:format": "oxfmt src/spec.json",
    "openapi:sdk": "npx openapi-generator-cli generate -i ./src/spec.json -g typescript-axios -o ../client/src/api --additional-properties=supportsES6=true",
    "typeorm": "TS_NODE_TRANSPILE_ONLY=true typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts"
  },
  "dependencies": {
    "@apalchys/pino-cloudwatch": "0.9.0",
    "@aws-sdk/client-s3": "3.749.0",
    "@nestjs/axios": "4.0.0",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.0",
    "@nestjs/core": "11.1.29",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/mapped-types": "2.1.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/schedule": "5.0.1",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/typeorm": "11.0.0",
    "@sentry/node": "8.55.0",
    "cache-manager": "6.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie": "0.7.2",
    "cookie-parser": "1.4.7",
    "date-fns": "2.30.0",
    "date-fns-tz": "2.0.1",
    "express": "5.2.1",
    "handlebars": "4.7.8",
    "ical-generator": "5.0.1",
    "json2csv": "5.0.7",
    "jsonwebtoken": "9.0.2",
    "nanoid": "3.3.8",
    "nestjs-pino": "4.6.0",
    "openai": "5.12.2",
    "passport": "0.6.0",
    "passport-custom": "1.1.1",
    "passport-github2": "0.1.12",
    "passport-http": "0.3.0",
    "passport-http-bearer": "^1.0.1",
    "passport-jwt": "4.0.1",
    "pg": "8.11.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.0.1",
    "rxjs": "7.8.1",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@openapitools/openapi-generator-cli": "2.20.0",
    "@types/cookie": "0.6.0",
    "@types/cookie-parser": "1.4.6",
    "@types/express": "5.0.6",
    "@types/json2csv": "5.0.7",
    "@types/jsonwebtoken": "9.0.5",
    "@types/passport-github2": "1.2.9",
    "@types/passport-http": "0.3.11",
    "@types/passport-http-bearer": "^1.0.42",
    "@types/passport-jwt": "3.0.13",
    "@types/supertest": "2.0.16",
