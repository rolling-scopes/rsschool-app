# Base URL of the RS School API. For local development point at your local
# NestJS instance, for production point at the deployed app.
# Examples:
#   http://localhost:3000          (local NestJS)
#   https://app.staging.rs.school  (staging)
#   https://app.rs.school          (production)
RSAPP_BASE_URL=http://localhost:3000

# Personal access token (PAT) created in RS School under Profile -> API tokens.
# Issued once, store securely, revoke if leaked. Must start with "rsapp_pat_".
# NOTE: rotate this PAT before/after go-live and never commit a real value —
# this file is .env.example; the real .env is git-ignored.
RSAPP_PAT=rsapp_pat_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Hosted (streamable HTTP) server only ---------------------------------
# DNS-rebinding / origin hardening for the public /mcp endpoint. Leave unset
# on a trusted network (protection stays off). When either is set, the transport
# rejects requests whose Host / Origin is not on the allow-list.
# Comma-separated. Example for production:
#   RSAPP_ALLOWED_HOSTS=app.rs.school
#   RSAPP_ALLOWED_ORIGINS=https://app.rs.school
RSAPP_ALLOWED_HOSTS=
RSAPP_ALLOWED_ORIGINS=
